<Window x:Class="AIO_Hybrid_Clipboard.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440">
    <Grid Margin="12">
        <Border Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource BorderHoverBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtTitle"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtPrompt"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Border Background="{StaticResource ControlBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6">
                    <TextBox x:Name="TxtInput"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentHoverBrush}"
                             SelectionBrush="{StaticResource AccentBrush}"
                             BorderThickness="0"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="TxtInput_PreviewKeyDown"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnCancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancel_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnOk"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
